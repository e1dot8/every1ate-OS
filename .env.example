# Every1.ate OS — variables d'environnement.
# Copier ce fichier en `.env` pour le développement local. Ne JAMAIS commiter `.env`.
# En production, les valeurs sont définies dans Netlify (Site settings → Environment variables),
# avec des valeurs différentes par contexte (Production / Deploy previews / Branch deploys).

# ── Base de données (PostgreSQL) ──────────────────────────────────────────────
# Connexion utilisée par l'application. Avec Neon : URL du *pooler* (hôte contenant « -pooler »).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/every1ate_os"

# Connexion directe (sans pooler) utilisée par le CLI Prisma pour les migrations.
# Facultative en local si identique à DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/every1ate_os"

# ── Authentification ──────────────────────────────────────────────────────────
# Secret de signature des sessions : 32 caractères minimum, différent par environnement.
# Générer : openssl rand -base64 32
BETTER_AUTH_SECRET="remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum"

# URL publique de l'application (liens des e-mails, origine de confiance).
# Local : http://localhost:3000 par défaut. Netlify : à définir pour chaque contexte
# (production = domaine final ; deploy previews = URL de la preview).
# APP_URL="https://every1ate-os.netlify.app"

# Vérification des nouveaux mots de passe dans les fuites connues (Have I Been Pwned, k-anonymat).
# on (défaut) | off (tests hors ligne uniquement)
PASSWORD_BREACH_CHECK="on"

# ── E-mails transactionnels ───────────────────────────────────────────────────
# outbox : les e-mails sont stockés dans la table email_outbox (développement, tests), rien ne part.
# resend : envoi réel. Par défaut : resend si RESEND_API_KEY est définie, sinon outbox.
EMAIL_TRANSPORT="outbox"
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Every1.ate OS <notifications@every1ate.com>"

# ── Tests end-to-end (facultatif) ─────────────────────────────────────────────
# Chemin vers un Chromium déjà installé, si Playwright ne peut pas télécharger le sien.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium

# Secret partagé entre la fonction planifiée Netlify et /api/cron/scan (32 caractères minimum).
# Génération : openssl rand -base64 32
CRON_SECRET=""
