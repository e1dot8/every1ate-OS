// Every1.ate OS — schéma Prisma.
// Lot 0 : une seule table technique. Les entités métier arrivent à partir du lot 1.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Paires clé/valeur techniques (version du socle, marqueurs d'initialisation).
/// Ne contient jamais de secret ni de donnée métier.
model SystemInfo {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_info")
}

// ─── Authentification (Better Auth) ─────────────────────────────────────────
// Champs imposés par Better Auth : ne pas renommer sans adapter src/lib/auth/auth.ts.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// V1 : « associe » uniquement. V2 : collaborateur, prestataire, client.
  role          String    @default("associe")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  invitationsSent Invitation[] @relation("InvitedBy")

  projectsOwned      Project[]           @relation("ProjectOwner")
  projectsCreated    Project[]           @relation("ProjectCreator")
  workPackagesOwned  WorkPackage[]       @relation("WorkPackageOwner")
  workPackageMembers WorkPackageMember[]
  tasksOwned         Task[]              @relation("TaskOwner")
  tasksCreated       Task[]              @relation("TaskCreator")
  taskContributions  TaskContributor[]
  closureItemsDone   ClosureItem[]
  timeEntries        TimeEntry[]
  taskComments       TaskComment[]
  notifications      Notification[]
  opportunitiesOwned Opportunity[]         @relation("OpportunityOwner")
  opportunitiesMade  Opportunity[]         @relation("OpportunityCreator")
  crmActivities      OpportunityActivity[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Empreinte scrypt (jamais le mot de passe en clair).
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Compteurs de limitation des requêtes vers /api/auth (stockage partagé entre fonctions serverless).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ─── Invitations ────────────────────────────────────────────────────────────

/// Seul moyen de créer un compte. Le jeton n'est jamais stocké en clair (SHA-256).
model Invitation {
  id          String    @id @default(cuid())
  email       String
  name        String
  tokenHash   String    @unique
  expiresAt   DateTime
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@map("invitation")
}

// ─── Journal d'audit ────────────────────────────────────────────────────────

/// Journal en ajout seul : un trigger PostgreSQL interdit UPDATE et DELETE.
/// Pas de clé étrangère vers user : le journal survit à toute évolution des comptes.
model AuditEvent {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  /// Projet concerné (pour le journal d'un projet), le cas échéant.
  projectId  String?
  action     String
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  userAgent  String?

  @@index([createdAt])
  @@index([action, targetId, createdAt])
  @@index([actorId])
  @@index([projectId, createdAt])
  @@map("audit_event")
}

// ─── E-mails (développement et tests) ───────────────────────────────────────

/// Boîte d'envoi locale utilisée quand EMAIL_TRANSPORT=outbox (aucun envoi réel).
model EmailOutbox {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  createdAt DateTime @default(now())

  @@index([to, createdAt])
  @@map("email_outbox")
}

// ─── Lot 2 : projets, lots, tâches ──────────────────────────────────────────
// Rien n'est supprimé : les objets métier s'archivent (archivedAt) et se restaurent.

enum ProjectPhase {
  RECETTE
  PREPARATION
  CUISSON
  DRESSAGE
  SERVICE
}

enum ProjectStatus {
  A_PREPARER
  ACTIF
  EN_ATTENTE
  BLOQUE
  TERMINE
  ARCHIVE
}

enum TaskStatus {
  A_FAIRE
  EN_COURS
  EN_REVUE
  TERMINE
  EN_ATTENTE
  BLOQUE
  ANNULE
}

enum Priority {
  BASSE
  NORMALE
  HAUTE
  URGENTE
}

/// Client (version minimale au lot 2, enrichie au lot 4 par le CRM).
model Client {
  id            String          @id @default(cuid())
  name          String
  /// Lot 4 : fiche entreprise du CRM.
  website       String?
  sector        String?
  address       String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  archivedAt    DateTime?
  projects      Project[]
  contacts      ClientContact[]
  opportunities Opportunity[]

  @@index([name])
  @@map("client")
}

model Project {
  id              String        @id @default(cuid())
  name            String
  description     String?
  clientId        String?
  client          Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  templateKey     String?
  ownerId         String
  owner           User          @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  phase           ProjectPhase  @default(RECETTE)
  status          ProjectStatus @default(A_PREPARER)
  statusReason    String?
  startDate       DateTime?     @db.Date
  plannedEndDate  DateTime?     @db.Date
  actualStartDate DateTime?     @db.Date
  actualEndDate   DateTime?     @db.Date
  closedAt        DateTime?
  closedById      String?
  closingReview   String?
  archivedAt      DateTime?
  createdById     String
  createdBy       User          @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  workPackages    WorkPackage[]
  tasks           Task[]
  closureItems    ClosureItem[]
  milestones      Milestone[]
  opportunity     Opportunity?

  @@index([status, archivedAt])
  @@index([ownerId])
  @@index([clientId])
  @@map("project")
}

/// Lot : périmètre de travail autonome rattaché à un projet.
model WorkPackage {
  id           String              @id @default(cuid())
  projectId    String
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name         String
  description  String?
  ownerId      String?
  owner        User?               @relation("WorkPackageOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  position     Int                 @default(0)
  plannedStart DateTime?           @db.Date
  plannedEnd   DateTime?           @db.Date
  actualStart  DateTime?           @db.Date
  actualEnd    DateTime?           @db.Date
  notes        String?
  archivedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  members      WorkPackageMember[]
  tasks        Task[]
  milestones   Milestone[]

  @@index([projectId, position])
  @@map("work_package")
}

model WorkPackageMember {
  workPackageId String
  workPackage   WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workPackageId, userId])
  @@map("work_package_member")
}

model Task {
  id                String            @id @default(cuid())
  projectId         String
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workPackageId     String?
  workPackage       WorkPackage?      @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  status            TaskStatus        @default(A_FAIRE)
  ownerId           String?
  owner             User?             @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  priority          Priority          @default(NORMALE)
  /// Priorité fixée à la main : aucun calcul ne la remplace (§7.4).
  priorityLocked    Boolean           @default(false)
  impact            Impact            @default(MOYEN)
  startDate         DateTime?         @db.Date
  dueDate           DateTime?         @db.Date
  estimatedMinutes  Int?
  blockedReason     String?
  blockedNextAction String?
  blockedReviewDate DateTime?         @db.Date
  cancelReason      String?
  position          Int               @default(0)
  completedAt       DateTime?
  archivedAt        DateTime?
  createdById       String
  createdBy         User              @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  contributors      TaskContributor[]
  dependsOn         TaskDependency[]  @relation("Successor")
  requiredBy        TaskDependency[]  @relation("Predecessor")
  timeEntries       TimeEntry[]
  comments          TaskComment[]

  @@index([projectId, archivedAt])
  @@index([ownerId, status])
  @@index([dueDate])
  @@index([workPackageId, position])
  @@map("task")
}

model TaskContributor {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_contributor")
}

/// « taskId attend dependsOnId » (fin → début).
model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation("Successor", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   Task     @relation("Predecessor", fields: [dependsOnId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
  @@map("task_dependency")
}

/// Checklist de clôture (§14.3).
model ClosureItem {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key         String
  label       String
  position    Int
  checked     Boolean   @default(false)
  checkedAt   DateTime?
  checkedById String?
  checkedBy   User?     @relation(fields: [checkedById], references: [id], onDelete: SetNull)
  note        String?

  @@unique([projectId, key])
  @@map("closure_item")
}

// ─── Lot 3 : roadmap, temps, priorités, notifications ──────────────────────

enum Impact {
  FAIBLE
  MOYEN
  FORT
}

enum TimeSource {
  TIMER
  MANUEL
}

model Milestone {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workPackageId String?
  workPackage   WorkPackage? @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  name          String
  date          DateTime     @db.Date
  reachedAt     DateTime?
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectId, date])
  @@map("milestone")
}

/// Un seul chronomètre actif par utilisateur : index unique partiel (migration).
model TimeEntry {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  taskId          String
  task            Task       @relation(fields: [taskId], references: [id], onDelete: Restrict)
  projectId       String
  /// Jour calendaire (Europe/Paris) auquel le temps est rattaché.
  date            DateTime   @db.Date
  startedAt       DateTime?
  endedAt         DateTime?
  durationMinutes Int?
  source          TimeSource
  comment         String?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId, date])
  @@index([taskId])
  @@index([projectId])
  @@map("time_entry")
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([taskId, createdAt])
  @@map("task_comment")
}

/// Centre de notifications. La clé de dédoublonnage évite les alertes répétitives
/// et la table conserve l'historique des alertes émises (§13.3).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  href      String?
  projectId String?
  taskId    String?
  dedupeKey String
  emailedAt DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notification")
}

// ─── Lot 4 : CRM ────────────────────────────────────────────────────────────

/// Étapes exactes du pipeline (§9.1).
enum OpportunityStage {
  A_CONTACTER
  PREMIER_ECHANGE
  QUALIFICATION
  PROPOSITION_ENVOYEE
  NEGOCIATION
  GAGNE
  PERDU
}

enum LeadSource {
  OUTBOUND
  INBOUND
  RECOMMANDATION
  RESEAU
  PARTENAIRE
}

enum ActivityKind {
  ECHANGE
  REUNION
  PROPOSITION
  NOTE
  RELANCE
  ETAPE
}

model ClientContact {
  id            String        @id @default(cuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  firstName     String
  lastName      String
  role          String?
  email         String?
  phone         String?
  notes         String?
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  opportunities Opportunity[]

  @@index([clientId])
  @@index([lastName])
  @@map("client_contact")
}

model Opportunity {
  id                String                @id @default(cuid())
  title             String
  clientId          String
  client            Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contactId         String?
  contact           ClientContact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId           String
  owner             User                  @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  stage             OpportunityStage      @default(A_CONTACTER)
  source            LeadSource?
  /// Montant estimé HT, en euros (jamais de flottant).
  amount            Decimal?              @db.Decimal(12, 2)
  /// Probabilité saisie ; à défaut, celle configurée pour l'étape.
  probability       Int?
  expectedCloseDate DateTime?             @db.Date
  nextAction        String?
  nextActionDate    DateTime?             @db.Date
  lossReason        String?
  closedAt          DateTime?
  /// Projet créé à la conversion : unique, garantit l'absence de doublon (§9.4).
  projectId         String?               @unique
  project           Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  archivedAt        DateTime?
  createdById       String
  createdBy         User                  @relation("OpportunityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  activities        OpportunityActivity[]

  @@index([stage, archivedAt])
  @@index([ownerId])
  @@index([clientId])
  @@index([nextActionDate])
  @@map("opportunity")
}

/// Historique chronologique (§9.2) : échanges, réunions, propositions, changements d'étape, notes.
model OpportunityActivity {
  id            String            @id @default(cuid())
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  authorId      String?
  author        User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind          ActivityKind
  body          String?
  fromStage     OpportunityStage?
  toStage       OpportunityStage?
  /// Référence vers une proposition (lien Drive…), jamais le fichier lui-même.
  fileUrl       String?
  occurredAt    DateTime          @default(now())
  createdAt     DateTime          @default(now())

  @@index([opportunityId, occurredAt])
  @@map("opportunity_activity")
}

/// Probabilités par défaut configurables par étape (§9.3).
model CrmStageSetting {
  stage       OpportunityStage @id
  probability Int
  updatedAt   DateTime         @updatedAt

  @@map("crm_stage_setting")
}
