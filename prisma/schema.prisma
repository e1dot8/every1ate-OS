// Every1.ate OS — schéma Prisma.
// Lot 0 : une seule table technique. Les entités métier arrivent à partir du lot 1.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Paires clé/valeur techniques (version du socle, marqueurs d'initialisation).
/// Ne contient jamais de secret ni de donnée métier.
model SystemInfo {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_info")
}

// ─── Authentification (Better Auth) ─────────────────────────────────────────
// Champs imposés par Better Auth : ne pas renommer sans adapter src/lib/auth/auth.ts.

model User {
  id                  String          @id
  name                String
  email               String          @unique
  emailVerified       Boolean         @default(false)
  image               String?
  /// V1 : « associe » uniquement. V2 : collaborateur, prestataire, client.
  role                String          @default("associe")
  /// Coût horaire interne (centimes) : valorise le temps passé dans les marges.
  hourlyCostCents     Int?
  /// Capacité de travail hebdomadaire (heures) pour la charge à venir.
  weeklyCapacityHours Int?
  /// Récapitulatif par e-mail : désactivé par défaut (choix de chaque associé).
  digestFrequency     DigestFrequency @default(AUCUN)
  /// Jour du dernier récapitulatif envoyé (évite les doublons).
  lastDigestOn        DateTime?       @db.Date
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  sessions            Session[]
  accounts            Account[]

  invitationsSent Invitation[] @relation("InvitedBy")

  projectsOwned      Project[]             @relation("ProjectOwner")
  projectsCreated    Project[]             @relation("ProjectCreator")
  workPackagesOwned  WorkPackage[]         @relation("WorkPackageOwner")
  workPackageMembers WorkPackageMember[]
  tasksOwned         Task[]                @relation("TaskOwner")
  tasksCreated       Task[]                @relation("TaskCreator")
  taskContributions  TaskContributor[]
  closureItemsDone   ClosureItem[]
  timeEntries        TimeEntry[]
  taskComments       TaskComment[]
  notifications      Notification[]
  opportunitiesOwned Opportunity[]         @relation("OpportunityOwner")
  opportunitiesMade  Opportunity[]         @relation("OpportunityCreator")
  crmActivities      OpportunityActivity[]
  decisionsRequested DecisionRequest[]     @relation("DecisionAuthor")
  decisionVotes      DecisionVote[]
  importBatches      ImportBatch[]
  eventsOrganized    CalendarEvent[]       @relation("EventOwner")
  eventAttendances   EventAttendee[]
  calendarFeed       CalendarFeed?
  filesAdded         FileReference[]
  meetingNotes       MeetingNote[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Empreinte scrypt (jamais le mot de passe en clair).
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Compteurs de limitation des requêtes vers /api/auth (stockage partagé entre fonctions serverless).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ─── Invitations ────────────────────────────────────────────────────────────

/// Seul moyen de créer un compte. Le jeton n'est jamais stocké en clair (SHA-256).
model Invitation {
  id          String    @id @default(cuid())
  email       String
  name        String
  tokenHash   String    @unique
  expiresAt   DateTime
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@map("invitation")
}

// ─── Journal d'audit ────────────────────────────────────────────────────────

/// Journal en ajout seul : un trigger PostgreSQL interdit UPDATE et DELETE.
/// Pas de clé étrangère vers user : le journal survit à toute évolution des comptes.
model AuditEvent {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  /// Projet concerné (pour le journal d'un projet), le cas échéant.
  projectId  String?
  action     String
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  userAgent  String?

  @@index([createdAt])
  @@index([action, targetId, createdAt])
  @@index([actorId])
  @@index([projectId, createdAt])
  @@map("audit_event")
}

// ─── E-mails (développement et tests) ───────────────────────────────────────

/// Boîte d'envoi locale utilisée quand EMAIL_TRANSPORT=outbox (aucun envoi réel).
model EmailOutbox {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  createdAt DateTime @default(now())

  @@index([to, createdAt])
  @@map("email_outbox")
}

// ─── Lot 2 : projets, lots, tâches ──────────────────────────────────────────
// Rien n'est supprimé : les objets métier s'archivent (archivedAt) et se restaurent.

enum ProjectPhase {
  RECETTE
  PREPARATION
  CUISSON
  DRESSAGE
  SERVICE
}

enum ProjectStatus {
  A_PREPARER
  ACTIF
  EN_ATTENTE
  BLOQUE
  TERMINE
  ARCHIVE
}

enum TaskStatus {
  A_FAIRE
  EN_COURS
  EN_REVUE
  TERMINE
  EN_ATTENTE
  BLOQUE
  ANNULE
}

enum Priority {
  BASSE
  NORMALE
  HAUTE
  URGENTE
}

/// Client (version minimale au lot 2, enrichie au lot 4 par le CRM).
model Client {
  id            String              @id @default(cuid())
  name          String
  /// Lot 4 : fiche entreprise du CRM.
  website       String?
  sector        String?
  address       String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  archivedAt    DateTime?
  projects      Project[]
  contacts      ClientContact[]
  opportunities Opportunity[]
  contracts     RecurringContract[]
  events        CalendarEvent[]
  files         FileReference[]
  meetingNotes  MeetingNote[]

  @@index([name])
  @@map("client")
}

model Project {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  clientId           String?
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  templateKey        String?
  ownerId            String
  owner              User                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  phase              ProjectPhase        @default(RECETTE)
  status             ProjectStatus       @default(A_PREPARER)
  statusReason       String?
  startDate          DateTime?           @db.Date
  plannedEndDate     DateTime?           @db.Date
  /// Fin prévue de référence (planning initial) pour la règle de retard majeur (§14.1).
  baselineEndDate    DateTime?           @db.Date
  actualStartDate    DateTime?           @db.Date
  actualEndDate      DateTime?           @db.Date
  closedAt           DateTime?
  closedById         String?
  closingReview      String?
  /// Satisfaction exprimée par le client à la clôture (1 à 5).
  clientSatisfaction Int?
  satisfactionNote   String?
  archivedAt         DateTime?
  createdById        String
  createdBy          User                @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  workPackages       WorkPackage[]
  tasks              Task[]
  closureItems       ClosureItem[]
  milestones         Milestone[]
  opportunity        Opportunity?
  budgetRevisions    BudgetRevision[]
  costItems          CostItem[]
  billing            BillingMilestone[]
  payments           PaymentRecord[]
  contracts          RecurringContract[]
  decisions          DecisionRequest[]
  events             CalendarEvent[]
  files              FileReference[]
  meetingNotes       MeetingNote[]

  @@index([status, archivedAt])
  @@index([ownerId])
  @@index([clientId])
  @@map("project")
}

/// Lot : périmètre de travail autonome rattaché à un projet.
model WorkPackage {
  id              String              @id @default(cuid())
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name            String
  description     String?
  ownerId         String?
  owner           User?               @relation("WorkPackageOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  position        Int                 @default(0)
  plannedStart    DateTime?           @db.Date
  plannedEnd      DateTime?           @db.Date
  actualStart     DateTime?           @db.Date
  actualEnd       DateTime?           @db.Date
  notes           String?
  archivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  members         WorkPackageMember[]
  tasks           Task[]
  milestones      Milestone[]
  budgetRevisions BudgetRevision[]
  costItems       CostItem[]
  billing         BillingMilestone[]
  fileReferences  FileReference[]

  @@index([projectId, position])
  @@map("work_package")
}

model WorkPackageMember {
  workPackageId String
  workPackage   WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workPackageId, userId])
  @@map("work_package_member")
}

model Task {
  id                String            @id @default(cuid())
  projectId         String
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workPackageId     String?
  workPackage       WorkPackage?      @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  status            TaskStatus        @default(A_FAIRE)
  ownerId           String?
  owner             User?             @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  priority          Priority          @default(NORMALE)
  /// Priorité fixée à la main : aucun calcul ne la remplace (§7.4).
  priorityLocked    Boolean           @default(false)
  impact            Impact            @default(MOYEN)
  recurrence        Recurrence        @default(AUCUNE)
  recurrenceUntil   DateTime?         @db.Date
  /// Occurrence suivante déjà créée (garantit une seule création).
  nextOccurrenceId  String?           @unique
  startDate         DateTime?         @db.Date
  dueDate           DateTime?         @db.Date
  estimatedMinutes  Int?
  blockedReason     String?
  blockedNextAction String?
  blockedReviewDate DateTime?         @db.Date
  cancelReason      String?
  position          Int               @default(0)
  completedAt       DateTime?
  archivedAt        DateTime?
  createdById       String
  createdBy         User              @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  contributors      TaskContributor[]
  dependsOn         TaskDependency[]  @relation("Successor")
  requiredBy        TaskDependency[]  @relation("Predecessor")
  timeEntries       TimeEntry[]
  comments          TaskComment[]
  files             FileReference[]

  @@index([projectId, archivedAt])
  @@index([ownerId, status])
  @@index([dueDate])
  @@index([workPackageId, position])
  @@map("task")
}

model TaskContributor {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_contributor")
}

/// « taskId attend dependsOnId » (fin → début).
model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation("Successor", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   Task     @relation("Predecessor", fields: [dependsOnId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
  @@map("task_dependency")
}

/// Checklist de clôture (§14.3).
model ClosureItem {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key         String
  label       String
  position    Int
  checked     Boolean   @default(false)
  checkedAt   DateTime?
  checkedById String?
  checkedBy   User?     @relation(fields: [checkedById], references: [id], onDelete: SetNull)
  note        String?

  @@unique([projectId, key])
  @@map("closure_item")
}

// ─── Lot 3 : roadmap, temps, priorités, notifications ──────────────────────

enum Impact {
  FAIBLE
  MOYEN
  FORT
}

enum TimeSource {
  TIMER
  MANUEL
}

model Milestone {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workPackageId String?
  workPackage   WorkPackage? @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  name          String
  date          DateTime     @db.Date
  reachedAt     DateTime?
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectId, date])
  @@map("milestone")
}

/// Un seul chronomètre actif par utilisateur : index unique partiel (migration).
model TimeEntry {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  taskId          String
  task            Task       @relation(fields: [taskId], references: [id], onDelete: Restrict)
  projectId       String
  /// Jour calendaire (Europe/Paris) auquel le temps est rattaché.
  date            DateTime   @db.Date
  startedAt       DateTime?
  endedAt         DateTime?
  durationMinutes Int?
  source          TimeSource
  comment         String?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId, date])
  @@index([taskId])
  @@index([projectId])
  @@map("time_entry")
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([taskId, createdAt])
  @@map("task_comment")
}

/// Centre de notifications. La clé de dédoublonnage évite les alertes répétitives
/// et la table conserve l'historique des alertes émises (§13.3).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  href      String?
  projectId String?
  taskId    String?
  dedupeKey String
  emailedAt DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notification")
}

// ─── Lot 4 : CRM ────────────────────────────────────────────────────────────

/// Étapes exactes du pipeline (§9.1).
enum OpportunityStage {
  A_CONTACTER
  PREMIER_ECHANGE
  QUALIFICATION
  PROPOSITION_ENVOYEE
  NEGOCIATION
  GAGNE
  PERDU
}

enum LeadSource {
  OUTBOUND
  INBOUND
  RECOMMANDATION
  RESEAU
  PARTENAIRE
}

enum ActivityKind {
  ECHANGE
  REUNION
  PROPOSITION
  NOTE
  RELANCE
  ETAPE
}

model ClientContact {
  id            String        @id @default(cuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  firstName     String
  lastName      String
  role          String?
  email         String?
  phone         String?
  notes         String?
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  opportunities Opportunity[]

  @@index([clientId])
  @@index([lastName])
  @@map("client_contact")
}

model Opportunity {
  id                String                @id @default(cuid())
  title             String
  clientId          String
  client            Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contactId         String?
  contact           ClientContact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId           String
  owner             User                  @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  stage             OpportunityStage      @default(A_CONTACTER)
  source            LeadSource?
  /// Montant estimé HT, en euros (jamais de flottant).
  amount            Decimal?              @db.Decimal(12, 2)
  /// Probabilité saisie ; à défaut, celle configurée pour l'étape.
  probability       Int?
  expectedCloseDate DateTime?             @db.Date
  nextAction        String?
  nextActionDate    DateTime?             @db.Date
  lossReason        String?
  closedAt          DateTime?
  /// Projet créé à la conversion : unique, garantit l'absence de doublon (§9.4).
  projectId         String?               @unique
  project           Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  archivedAt        DateTime?
  createdById       String
  createdBy         User                  @relation("OpportunityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  activities        OpportunityActivity[]
  events            CalendarEvent[]
  meetingNotes      MeetingNote[]

  @@index([stage, archivedAt])
  @@index([ownerId])
  @@index([clientId])
  @@index([nextActionDate])
  @@map("opportunity")
}

/// Historique chronologique (§9.2) : échanges, réunions, propositions, changements d'étape, notes.
model OpportunityActivity {
  id            String            @id @default(cuid())
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  authorId      String?
  author        User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind          ActivityKind
  body          String?
  fromStage     OpportunityStage?
  toStage       OpportunityStage?
  /// Référence vers une proposition (lien Drive…), jamais le fichier lui-même.
  fileUrl       String?
  occurredAt    DateTime          @default(now())
  createdAt     DateTime          @default(now())

  @@index([opportunityId, occurredAt])
  @@map("opportunity_activity")
}

/// Probabilités par défaut configurables par étape (§9.3).
model CrmStageSetting {
  stage       OpportunityStage @id
  probability Int
  updatedAt   DateTime         @updatedAt

  @@map("crm_stage_setting")
}

// ─── Lot 5 : finance et gouvernance ─────────────────────────────────────────
// Montants HT en Decimal(12,2). Prévu ≠ engagé ≠ facturé ≠ payé : statuts distincts (§10.1).

enum CostStatus {
  PREVU
  ENGAGE
  FACTURE
  PAYE
  ANNULE
}

enum PricingMode {
  FORFAIT
  TEMPS
  FRAIS
}

enum RecordSource {
  MANUEL
  IMPORT
}

enum BillingKind {
  ACOMPTE
  INTERMEDIAIRE
  SOLDE
  AUTRE
}

/// Statut saisi. « Partiellement encaissé », « encaissé » et « en retard » sont calculés.
enum BillingStatus {
  ATTENDU
  FACTURE
  ANNULE
}

enum ContractStatus {
  BROUILLON
  ACTIF
  SUSPENDU
  RESILIE
  TERMINE
}

enum RevisionStatus {
  APPLIQUEE
  EN_ATTENTE
  REFUSEE
}

enum DecisionKind {
  BUDGET
  PLANNING
  PERIMETRE
}

enum DecisionStatus {
  OUVERTE
  APPROUVEE
  REFUSEE
  ANNULEE
}

enum VoteChoice {
  POUR
  CONTRE
  ABSTENTION
}

enum ImportKind {
  COUTS
  ENCAISSEMENTS
}

enum ImportStatus {
  BROUILLON
  IMPORTE
  ANNULE
}

/// Historique des budgets (projet si workPackageId est nul, sinon lot).
model BudgetRevision {
  id             String           @id @default(cuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workPackageId  String?
  workPackage    WorkPackage?     @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  isInitial      Boolean          @default(false)
  plannedRevenue Decimal          @db.Decimal(12, 2)
  plannedCost    Decimal          @db.Decimal(12, 2)
  pricingMode    PricingMode?
  reason         String?
  status         RevisionStatus   @default(APPLIQUEE)
  decisionId     String?          @unique
  decision       DecisionRequest? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  createdById    String
  createdAt      DateTime         @default(now())

  @@index([projectId, workPackageId, createdAt])
  @@map("budget_revision")
}

model CostItem {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workPackageId String?
  workPackage   WorkPackage? @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  supplier      String?
  description   String
  category      String?
  pricingMode   PricingMode  @default(FRAIS)
  quantity      Decimal?     @db.Decimal(12, 3)
  unit          String?
  unitRate      Decimal?     @db.Decimal(12, 2)
  amount        Decimal      @db.Decimal(12, 2)
  vatAmount     Decimal?     @db.Decimal(12, 2)
  amountTTC     Decimal?     @db.Decimal(12, 2)
  status        CostStatus   @default(PREVU)
  committedAt   DateTime?    @db.Date
  invoiceDate   DateTime?    @db.Date
  dueDate       DateTime?    @db.Date
  paidAt        DateTime?    @db.Date
  documentRef   String?
  rebillable    Boolean      @default(false)
  source        RecordSource @default(MANUEL)
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  externalId    String?
  archivedAt    DateTime?
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectId, status])
  @@index([workPackageId])
  @@index([importBatchId])
  @@index([externalId])
  @@map("cost_item")
}

model BillingMilestone {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workPackageId String?
  workPackage   WorkPackage?    @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  label         String
  kind          BillingKind     @default(AUTRE)
  plannedDate   DateTime?       @db.Date
  amount        Decimal         @db.Decimal(12, 2)
  vatAmount     Decimal?        @db.Decimal(12, 2)
  status        BillingStatus   @default(ATTENDU)
  invoiceRef    String?
  invoiceUrl    String?
  invoicedAt    DateTime?       @db.Date
  archivedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  payments      PaymentRecord[]

  @@index([projectId, plannedDate])
  @@index([invoiceRef])
  @@map("billing_milestone")
}

model PaymentRecord {
  id                 String            @id @default(cuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  billingMilestoneId String?
  billingMilestone   BillingMilestone? @relation(fields: [billingMilestoneId], references: [id], onDelete: SetNull)
  amount             Decimal           @db.Decimal(12, 2)
  receivedAt         DateTime          @db.Date
  reference          String?
  label              String?
  source             RecordSource      @default(MANUEL)
  importBatchId      String?
  importBatch        ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  externalId         String?
  deletedAt          DateTime?
  createdById        String
  createdAt          DateTime          @default(now())

  @@index([projectId, receivedAt])
  @@index([billingMilestoneId])
  @@index([importBatchId])
  @@map("payment_record")
}

model RecurringContract {
  id             String         @id @default(cuid())
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  label          String
  monthlyAmount  Decimal        @db.Decimal(12, 2)
  startDate      DateTime       @db.Date
  endDate        DateTime?      @db.Date
  durationMonths Int?
  status         ContractStatus @default(ACTIF)
  renewalDate    DateTime?      @db.Date
  noticeDays     Int?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@map("recurring_contract")
}

/// Import CSV/Excel : brouillon (lignes brutes + correspondance) puis importé ou annulé.
model ImportBatch {
  id            String          @id @default(cuid())
  kind          ImportKind?
  fileName      String
  fileHash      String
  status        ImportStatus    @default(BROUILLON)
  headers       Json
  rows          Json
  mapping       Json?
  projectId     String?
  report        Json?
  rowCount      Int             @default(0)
  importedCount Int             @default(0)
  skippedCount  Int             @default(0)
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now())
  importedAt    DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  costs         CostItem[]
  payments      PaymentRecord[]

  @@index([createdAt])
  @@index([fileHash])
  @@map("import_batch")
}

/// Seuils de gouvernance (§14.1) : valeurs non définies au départ, configurables et journalisées.
model GovernanceSetting {
  id                String   @id @default("default")
  budgetOverrunPct  Int?
  delayPct          Int?
  delayMinDays      Int?
  /// Nombre d'avis « pour » requis. Règle de majorité/quorum À CONFIRMER par les associés.
  requiredApprovals Int      @default(2)
  /// Si vrai, le changement n'est appliqué qu'après approbation.
  blocking          Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  @@map("governance_setting")
}

model DecisionRequest {
  id                String          @id @default(cuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  kind              DecisionKind
  title             String
  explanation       String
  consequences      String?
  before            Json?
  after             Json?
  status            DecisionStatus  @default(OUVERTE)
  requiredApprovals Int
  blocking          Boolean         @default(true)
  createdById       String
  createdBy         User            @relation("DecisionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())
  decidedAt         DateTime?
  votes             DecisionVote[]
  budgetRevision    BudgetRevision?

  @@index([status, createdAt])
  @@index([projectId])
  @@map("decision_request")
}

model DecisionVote {
  id         String          @id @default(cuid())
  decisionId String
  decision   DecisionRequest @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  choice     VoteChoice
  comment    String?
  createdAt  DateTime        @default(now())

  @@unique([decisionId, userId])
  @@map("decision_vote")
}

// ─── Lot 6 : calendrier et documents ───────────────────────────────────────

/// Par défaut, les autres associés ne voient qu'un créneau « occupé » (§11.1).
enum EventVisibility {
  OCCUPE
  PARTAGE
}

enum FileKind {
  DOCUMENT
  DOSSIER
  MEDIA
  AUTRE
}

enum FileStatus {
  NON_VERIFIE
  OK
  INTROUVABLE
  ERREUR
}

model CalendarEvent {
  id            String          @id @default(cuid())
  title         String
  description   String?
  location      String?
  /// Instants en UTC ; affichage et saisie en Europe/Paris.
  startsAt      DateTime
  endsAt        DateTime
  allDay        Boolean         @default(false)
  visibility    EventVisibility @default(OCCUPE)
  ownerId       String
  owner         User            @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  /// Verrou optimiste : détecte les modifications concurrentes.
  version       Int             @default(1)
  cancelledAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  attendees     EventAttendee[]
  meetingNotes  MeetingNote[]

  @@index([startsAt, endsAt])
  @@index([ownerId])
  @@index([projectId])
  @@map("calendar_event")
}

model EventAttendee {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_attendee")
}

/// Flux ICS personnel en lecture seule (abonnement Google/Apple). Seule l'empreinte du jeton est stockée.
model CalendarFeed {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  includeTasks Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastAccessAt DateTime?
  accessCount  Int       @default(0)

  @@map("calendar_feed")
}

/// Référence vers un document externe (Google Drive…) : le fichier n'est pas copié (§12.1).
model FileReference {
  id            String       @id @default(cuid())
  title         String
  url           String
  kind          FileKind     @default(DOCUMENT)
  provider      String       @default("google_drive")
  externalId    String?
  ownerLabel    String?
  documentDate  DateTime?    @db.Date
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workPackageId String?
  workPackage   WorkPackage? @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  taskId        String?
  task          Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status        FileStatus   @default(NON_VERIFIE)
  statusDetail  String?
  lastCheckedAt DateTime?
  addedById     String
  addedBy       User         @relation(fields: [addedById], references: [id], onDelete: Restrict)
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectId])
  @@index([taskId])
  @@index([clientId])
  @@index([externalId])
  @@map("file_reference")
}

// ─── Évolutions V1.1 : pilotage gratuit, sans IA ────────────────────────────

enum DigestFrequency {
  AUCUN
  QUOTIDIEN
  HEBDOMADAIRE
}

enum Recurrence {
  AUCUNE
  HEBDOMADAIRE
  MENSUELLE
}

enum ChargeFrequency {
  MENSUELLE
  TRIMESTRIELLE
  ANNUELLE
}

/// Réglages de l'agence (une seule ligne).
model AgencySetting {
  id                     String    @id @default("default")
  /// Coût horaire interne par défaut (centimes), si l'associé n'a pas le sien.
  defaultHourlyCostCents Int?
  defaultWeeklyHours     Int       @default(35)
  /// Solde bancaire saisi à la main (point de départ de la trésorerie prévisionnelle).
  cashBalance            Decimal?  @db.Decimal(12, 2)
  cashBalanceDate        DateTime? @db.Date
  updatedAt              DateTime  @updatedAt

  @@map("agency_setting")
}

/// Charges fixes récurrentes (loyer, salaires, abonnements) pour la trésorerie à 90 jours.
model RecurringCharge {
  id         String          @id @default(cuid())
  label      String
  category   String?
  amount     Decimal         @db.Decimal(12, 2)
  frequency  ChargeFrequency @default(MENSUELLE)
  nextDate   DateTime        @db.Date
  endDate    DateTime?       @db.Date
  archivedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@map("recurring_charge")
}

/// Objectifs annuels de l'agence (chiffre d'affaires facturé, marge, nombre de projets).
model AnnualObjective {
  year         Int      @id
  revenue      Decimal? @db.Decimal(12, 2)
  margin       Decimal? @db.Decimal(12, 2)
  projectCount Int?
  updatedAt    DateTime @updatedAt

  @@map("annual_objective")
}

/// Compte rendu de réunion : les lignes d'action deviennent des tâches après confirmation.
model MeetingNote {
  id            String         @id @default(cuid())
  title         String
  body          String
  occurredAt    DateTime       @db.Date
  authorId      String
  author        User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  eventId       String?
  event         CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdTasks  Int            @default(0)
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([projectId])
  @@index([clientId])
  @@index([opportunityId])
  @@map("meeting_note")
}
