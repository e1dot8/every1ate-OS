{
  "name": "every1ate-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:netlify": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:bundle"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-slot": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.2",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  }
}
